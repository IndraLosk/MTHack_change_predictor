                        "dataset": "mthack",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT DISTINCT ON (unit_id)\r\n  unit_id AS metric, \r\n  lat::numeric AS latitude, \r\n  lon::numeric AS longitude, \r\n  speed::numeric AS speed,\r\n  event_time::timestamp AS time\r\nFROM ndtp_telemetry\r\nORDER BY unit_id, event_time::timestamp DESC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
