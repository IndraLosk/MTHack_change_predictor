                      },
                      "spec": {
                        "dataset": "mthack",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \r\n  unit_id AS metric,\r\n  json_build_object(\r\n    'type', 'LineString',\r\n    'coordinates', json_agg(json_build_array(lon::numeric, lat::numeric) ORDER BY event_time::timestamp ASC)\r\n  )::text AS geometry\r\nFROM ndtp_telemetry\r\nWHERE event_time::timestamp >= now() - interval '30 minutes'\r\nGROUP BY unit_id;",
